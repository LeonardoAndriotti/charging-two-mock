PORT=9083
# Required on Vercel; optional locally. Set secrets in Vercel project settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOCK_STATE_KEY=charging-two-mock:development:state:v1

# Vercel Marketplace aliases (used if both UPSTASH variables are empty):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# On Vercel, an omitted MOCK_STATE_KEY defaults to <profile>:<VERCEL_ENV>:state:v1.
